<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Startsida - Rymdresa</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #050515;
            color: #ffffff;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            position: relative;
        }

        /* Stjärnhimmel-bakgrund med CSS */
        .stars {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            background-image: 
                radial-gradient(white 1px, transparent 0),
                radial-gradient(rgba(255,255,255,0.6) 1.5px, transparent 0);
            background-size: 50px 50px, 120px 120px;
            background-position: 0 0, 30px 30px;
            z-index: -1;
            animation: twinkle 100s linear infinite;
        }

        @keyframes twinkle {
            from { background-position: 0 0, 30px 30px; }
            to { background-position: -1000px 1000px, 1200px -1200px; }
        }

        header {
            text-align: center;
            margin: 40px 20px 20px 20px;
            z-index: 2;
        }

        h1 {
            font-size: 3rem;
            letter-spacing: 2px;
            background: linear-gradient(45deg, #00ffff, #7b2cbf, #ff007f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(123, 44, 191, 0.5);
            margin-bottom: 10px;
        }

        p.subtitle {
            font-size: 1.1rem;
            color: #a0a0c0;
        }

        /* Huvudbild / Solsystemets vy */
        .hero-container {
            position: relative;
            width: 90%;
            max-width: 900px;
            height: 380px;
            margin: 20px auto;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 0 30px rgba(0, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: radial-gradient(circle at center, #1b1b3a 0%, #09091a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .solar-graphic {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 20px;
            position: relative;
        }

        /* Stiliserade planeter i huvudbilden */
        .planet-art {
            border-radius: 50%;
            box-shadow: inset -10px -10px 20px rgba(0,0,0,0.8), 0 0 15px rgba(255,255,255,0.2);
            transition: transform 0.3s ease;
        }

        .planet-art:hover {
            transform: scale(1.1);
        }

        .sun {
            width: 90px;
            height: 90px;
            background: radial-gradient(circle at 30% 30%, #ffcc00, #ff3300);
            box-shadow: 0 0 40px #ff6600, inset -10px -10px 20px rgba(0,0,0,0.5);
        }

        .earth-art {
            width: 60px;
            height: 60px;
            background: radial-gradient(circle at 30% 30%, #4da6ff, #004080);
        }

        .jupiter-art {
            width: 80px;
            height: 80px;
            background: radial-gradient(circle at 30% 30%, #e6b800, #b35900, #803300);
        }

        .saturn-art {
            width: 65px;
            height: 65px;
            background: radial-gradient(circle at 30% 30%, #ffdb4d, #cca300);
            position: relative;
        }

        /* Saturnus ringar */
        .saturn-art::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(25deg);
            width: 110px;
            height: 30px;
            border: 4px solid rgba(210, 180, 140, 0.7);
            border-radius: 50%;
            pointer-events: none;
        }

        .moon-art {
            width: 40px;
            height: 40px;
            background: radial-gradient(circle at 30% 30%, #d9d9d9, #595959);
        }

        /* 4 Knappar */
        .button-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            width: 90%;
            max-width: 800px;
            margin: 30px auto;
            z-index: 2;
        }

        .space-btn {
            background: rgba(20, 20, 40, 0.7);
            border: 2px solid #00ffff;
            color: #00ffff;
            padding: 15px 20px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 0 10px rgba(0, 255, 255, 0.2);
            text-align: center;
            backdrop-filter: blur(5px);
        }

        .space-btn:hover {
            background: #00ffff;
            color: #050515;
            box-shadow: 0 0 25px #00ffff;
            transform: translateY(-3px);
        }

        /* Informationskort som visas när man klickar */
        .info-card {
            width: 90%;
            max-width: 800px;
            background: rgba(15, 15, 35, 0.85);
            border: 1px solid rgba(0, 255, 255, 0.4);
            border-radius: 15px;
            padding: 25px;
            margin: 20px auto 40px auto;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            display: none;
            animation: fadeIn 0.5s ease forwards;
            z-index: 2;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .info-card h2 {
            color: #00ffff;
            margin-bottom: 12px;
            font-size: 1.8rem;
        }

        .info-card p {
            color: #d0d0e0;
            line-height: 1.6;
            font-size: 1.05rem;
        }

        footer {
            margin-top: auto;
            padding: 20px;
            text-align: center;
            color: #666688;
            font-size: 0.9rem;
            z-index: 2;
        }
    </style>
</head>
<body>

    <!-- Stjärnbakgrund -->
    <div class="stars"></div>

    <header>
        <h1>Startsida</h1>
        <p class="subtitle">Välkommen till rymden – klicka på en himlakropp nedan för att utforska fakta</p>
    </header>

    <!-- Huvudbild med planeter -->
    <div class="hero-container">
        <div class="solar-graphic">
            <div class="planet-art sun" title="Solen"></div>
            <div class="planet-art earth-art" title="Jorden"></div>
            <div class="planet-art jupiter-art" title="Jupiter"></div>
            <div class="planet-art saturn-art" title="Saturnus"></div>
            <div class="planet-art moon-art" title="Månen"></div>
        </div>
    </div>

    <!-- 4 Knappar -->
    <div class="button-container">
        <button class="space-btn" onclick="showInfo('jorden')">Jorden</button>
        <button class="space-btn" onclick="showInfo('jupiter')">Jupiter</button>
        <button class="space-btn" onclick="showInfo('månen')">Månen</button>
        <button class="space-btn" onclick="showInfo('saturnus')">Saturnus</button>
    </div>

    <!-- Informationsruta -->
    <div id="info-card" class="info-card">
        <h2 id="info-title">Välj en destination</h2>
        <p id="info-text">Klicka på någon av knapparna ovan för att läsa mer om planeten eller månen.</p>
    </div>

    <footer>
        <p>&copy; 2026 Startsida | Rymdutforskaren</p>
    </footer>

    <script>
        const infoData = {
            jorden: {
                title: "🌍 Jorden – Vår hemplanet",
                text: "Jorden är den tredje planeten från solen och den enda kända platsen i universum där det finns liv. Ungefär 71 % av jordens yta är täckt av vatten, vilket har gett den namnet 'Den blå planeten'."
            },
            jupiter: {
                title: "🪐 Jupiter – Solsystemets jätte",
                text: "Jupiter är den största planeten i vårt solsystem. Den är en gasjätte som är mest känd för sin stora röda fläck, vilket är en gigantisk storm som har rasat i hundratals år."
            },
            månen: {
                title: "🌙 Månen – Jordens naturliga satellit",
                text: "Månen är jordens enda naturliga satellit och den femte största månen i solsystemet. Den kretsar kring jorden på ett avstånd av cirka 384 400 km."
            },
            saturnus: {
                title: "🪐 Saturnus – Ringarnas planet",
                text: "Saturnus är den sjätte planeten från solen och den näst största i solsystemet. Den är känd för sitt spektakulära system av ringar som till största del består av ispartiklar och stendamm."
            }
        };

        function showInfo(target) {
            const card = document.getElementById('info-card');
            const title = document.getElementById('info-title');
            const text = document.getElementById('info-text');

            if (infoData[target]) {
                title.innerText = infoData[target].title;
                text.innerText = infoData[target].text;
                card.style.display = 'block';
                card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    </script>
</body>
</html>
